# Envoy Gateway component: pinned chart → committed base manifest (SPEC D2,
# D26), plus the CRD artifacts (CRDs-first ordering is the consumer's
# contract, SPEC D29) and the airgap data-plane image tarball. The canonical
# consumption path is the committed files under manifests/gateway-envoy/,
# kept in sync by the freshness checks and regenerated by
# `nix run .#update-manifests`.
{self, ...}: let
  versions = import ../../pkgs/envoy-gateway/versions.nix;
in {
  # Committed-manifest registry: update-manifests re-renders each entry
  # (package output) into manifests/<path>.
  flake.lib.manifestArtifacts = {
    envoy-gateway = {
      package = "manifest-envoy-gateway";
      path = "gateway-envoy/${versions.egVersion}.yaml";
    };
    envoy-gateway-crds = {
      package = "crds-envoy-gateway";
      path = "gateway-envoy/${versions.egVersion}-crds.yaml";
    };
    gateway-api-standard-crds = {
      package = "gateway-api-standard-crds";
      path = "gateway-envoy/gateway-api-standard-${versions.gatewayApi.version}.yaml";
    };
    gateway-api-experimental-crds = {
      package = "gateway-api-experimental-crds";
      path = "gateway-envoy/gateway-api-experimental-${versions.gatewayApi.version}.yaml";
    };
  };

  perSystem = {pkgs, ...}: let
    chart = self.lib.fetchOciChart pkgs {
      name = "envoy-gateway";
      ref = versions.chartRef;
      hash = versions.chartHash;
    };
    rendered = self.lib.renderChart pkgs {
      name = "envoy-gateway";
      namespace = "envoy-gateway-system";
      inherit chart;
      values = import ../../pkgs/envoy-gateway/values.nix;
      kubeVersion = self.lib.versions.kubernetes;
    };
    # The chart ships CRDs in its `crds` subchart (charts/crds/crds/, with
    # the EG CRDs one level deeper under generated/), which lib.chartCrds'
    # unpack/*/crds/*.yaml glob cannot reach — repack them into a synthetic
    # chart with a top-level <dir>/crds/ holding every CRD file.
    crdsChart = pkgs.runCommand "chart-envoy-gateway-crds" {} ''
      mkdir unpack
      tar -xzf ${chart} -C unpack
      mkdir -p repack/envoy-gateway/crds
      cp unpack/gateway-helm/charts/crds/crds/*.yaml repack/envoy-gateway/crds/
      cp unpack/gateway-helm/charts/crds/crds/generated/*.yaml repack/envoy-gateway/crds/
      tar -czf $out -C repack envoy-gateway
    '';
    crds = self.lib.chartCrds pkgs {
      name = "envoy-gateway";
      chart = crdsChart;
    };
    gatewayApiStandard = pkgs.fetchurl {
      url = versions.gatewayApi.standardUrl;
      hash = versions.gatewayApi.standardHash;
    };
    gatewayApiExperimental = pkgs.fetchurl {
      url = versions.gatewayApi.experimentalUrl;
      hash = versions.gatewayApi.experimentalHash;
    };
  in {
    packages = {
      manifest-envoy-gateway = rendered;
      crds-envoy-gateway = crds;
      gateway-api-standard-crds = gatewayApiStandard;
      gateway-api-experimental-crds = gatewayApiExperimental;
      # Airgap image artifact: the exact data-plane image the pinned EG
      # deploys (SPEC D2), as a docker-archive tarball for cluster-side
      # loading instead of registry pulls.
      image-envoy = pkgs.dockerTools.pullImage {
        imageName = versions.envoyImage.repo;
        finalImageTag = versions.envoyImage.tag;
        imageDigest = versions.envoyImage.digest;
        sha256 = versions.envoyImage.archiveHash;
        arch = "amd64";
        os = "linux";
      };
    };
    checks = {
      manifest-envoy-gateway-freshness = self.lib.manifestFreshnessCheck pkgs {
        name = "envoy-gateway";
        committed = self + "/manifests/gateway-envoy/${versions.egVersion}.yaml";
        inherit rendered;
      };
      crds-envoy-gateway-freshness = self.lib.manifestFreshnessCheck pkgs {
        name = "envoy-gateway-crds";
        committed = self + "/manifests/gateway-envoy/${versions.egVersion}-crds.yaml";
        rendered = crds;
      };
      gateway-api-standard-crds-freshness = self.lib.manifestFreshnessCheck pkgs {
        name = "gateway-api-standard-crds";
        committed = self + "/manifests/gateway-envoy/gateway-api-standard-${versions.gatewayApi.version}.yaml";
        rendered = gatewayApiStandard;
      };
      gateway-api-experimental-crds-freshness = self.lib.manifestFreshnessCheck pkgs {
        name = "gateway-api-experimental-crds";
        committed = self + "/manifests/gateway-envoy/gateway-api-experimental-${versions.gatewayApi.version}.yaml";
        rendered = gatewayApiExperimental;
      };
    };
  };
}
