# Flux component (SPEC §7 phase 2): pinned flux-operator chart + pinned Flux
# distribution install manifest → committed base manifests, plus the airgap
# image mirror set. packages.manifest-flux-operator / manifest-flux-distribution
# are the fresh renders; the canonical consumption path is the committed files
# under manifests/flux/, kept in sync by checks.manifest-flux-*-freshness and
# regenerated by `nix run .#update-manifests`. packages.image-flux-* are
# digest-pinned image tarballs; packages.flux-airgap-images collects them into
# one directory.
{self, ...}: let
  versions = import ../../pkgs/flux/versions.nix;
  # "v2.9.6" -> "2.9.6" (committed distribution manifest path convention).
  distributionVersion = builtins.substring 1 (builtins.stringLength versions.distribution.tag - 1) versions.distribution.tag;
in {
  # Committed-manifest registry: update-manifests re-renders each entry
  # (package output) into manifests/<path>.
  flake.lib.manifestArtifacts = {
    flux-operator = {
      package = "manifest-flux-operator";
      path = "flux/operator-${versions.operatorChart.version}.yaml";
    };
    flux-distribution = {
      package = "manifest-flux-distribution";
      path = "flux/flux-${distributionVersion}.yaml";
    };
  };

  perSystem = {pkgs, ...}: let
    chart = self.lib.fetchOciChart pkgs {
      name = "flux-operator";
      inherit (versions.operatorChart) ref hash;
    };
    rendered = self.lib.renderChart pkgs {
      name = "flux-operator";
      namespace = "flux-system";
      inherit chart;
      values = import ../../pkgs/flux/values.nix;
      kubeVersion = self.lib.versions.kubernetes;
    };
    distribution = pkgs.fetchurl {
      inherit (versions.distribution) url hash;
    };
    imageTarballs = builtins.listToAttrs (map (img: {
        name = "image-flux-${img.name}";
        value = pkgs.dockerTools.pullImage {
          inherit (img) sha256;
          imageName = img.repo;
          imageDigest = img.digest;
          finalImageName = img.repo;
          finalImageTag = img.tag;
        };
      })
      versions.images);
  in {
    packages =
      {
        manifest-flux-operator = rendered;
        manifest-flux-distribution = distribution;
        flux-airgap-images = pkgs.runCommand "flux-airgap-images" {} ''
          mkdir -p $out
          ${builtins.concatStringsSep "\n" (map (img: "ln -s ${imageTarballs."image-flux-${img.name}"} $out/flux-${img.name}-${img.tag}.tar") versions.images)}
        '';
      }
      // imageTarballs;
    checks = {
      manifest-flux-operator-freshness = self.lib.manifestFreshnessCheck pkgs {
        name = "flux-operator";
        committed = self + "/manifests/flux/operator-${versions.operatorChart.version}.yaml";
        inherit rendered;
      };
      manifest-flux-distribution-freshness = self.lib.manifestFreshnessCheck pkgs {
        name = "flux-distribution";
        committed = self + "/manifests/flux/flux-${distributionVersion}.yaml";
        rendered = distribution;
      };
    };
  };
}
