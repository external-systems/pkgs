# cert-manager component: pinned chart → committed base manifest + CRDs
# artifact (SPEC §5.8, D26, D29). packages.manifest-cert-manager is the fresh
# render; the canonical consumption path is the committed files under
# manifests/cert-manager/, kept in sync by the freshness checks and
# regenerated by `nix run .#update-manifests`.
{self, ...}: {
  # Committed-manifest registry: update-manifests re-renders each entry
  # (package output) into manifests/<path>.
  flake.lib.manifestArtifacts = {
    cert-manager = {
      package = "manifest-cert-manager";
      path = "cert-manager/${(import ../../pkgs/cert-manager/versions.nix).chartVersion}.yaml";
    };
    cert-manager-crds = {
      package = "crds-cert-manager";
      path = "cert-manager/${(import ../../pkgs/cert-manager/versions.nix).chartVersion}-crds.yaml";
    };
  };

  perSystem = {pkgs, ...}: let
    versions = import ../../pkgs/cert-manager/versions.nix;
    values = import ../../pkgs/cert-manager/values.nix;
    chart = pkgs.fetchurl {
      url = versions.chartUrl;
      hash = versions.chartHash;
    };
    rendered = self.lib.renderChart pkgs {
      name = "cert-manager";
      inherit chart values;
      kubeVersion = self.lib.versions.kubernetes;
    };
    # The v1.21 chart ships CRDs as templates gated by crds.enabled — there
    # is no crds/ directory for lib.chartCrds to extract — so the CRDs
    # artifact is a render with the gate flipped, filtered to CRD documents.
    crds = let
      crdsRender = self.lib.renderChart pkgs {
        name = "cert-manager-crds-render";
        releaseName = "cert-manager";
        inherit chart;
        values = values // {crds.enabled = true;};
        kubeVersion = self.lib.versions.kubernetes;
      };
    in
      pkgs.runCommand "crds-cert-manager" {nativeBuildInputs = [pkgs.yq-go];} ''
        yq eval 'select(.kind == "CustomResourceDefinition")' ${crdsRender} > $out
      '';
    pullImage = img:
      pkgs.dockerTools.pullImage {
        imageName = img.repo;
        imageDigest = img.digest;
        inherit (img) sha256;
        os = "linux";
        arch = "amd64";
      };
  in {
    packages = {
      manifest-cert-manager = rendered;
      crds-cert-manager = crds;
      image-cert-manager-controller = pullImage versions.images.controller;
      image-cert-manager-webhook = pullImage versions.images.webhook;
      image-cert-manager-cainjector = pullImage versions.images.cainjector;
    };
    checks = {
      manifest-cert-manager-freshness = self.lib.manifestFreshnessCheck pkgs {
        name = "cert-manager";
        committed = self + "/manifests/cert-manager/${versions.chartVersion}.yaml";
        inherit rendered;
      };
      manifest-cert-manager-crds-freshness = self.lib.manifestFreshnessCheck pkgs {
        name = "cert-manager-crds";
        committed = self + "/manifests/cert-manager/${versions.chartVersion}-crds.yaml";
        rendered = crds;
      };
    };
  };
}
