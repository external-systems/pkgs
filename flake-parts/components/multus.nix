# Multus component: pinned upstream thick-plugin daemonset manifest
# (SPEC §6). There is no chart to render — packages.manifest-multus is the
# fetchurl itself; the canonical consumption path is the committed file
# manifests/multus/<version>.yaml, kept in sync by
# checks.manifest-multus-freshness and regenerated by
# `nix run .#update-manifests`.
{self, ...}: {
  # Committed-manifest registry: update-manifests re-renders each entry
  # (package output) into manifests/<path>.
  flake.lib.manifestArtifacts.multus = {
    package = "manifest-multus";
    path = "multus/${(import ../../pkgs/multus/versions.nix).version}.yaml";
  };

  perSystem = {pkgs, ...}: let
    versions = import ../../pkgs/multus/versions.nix;
    fetched = pkgs.fetchurl {
      inherit (versions) url hash;
    };
  in {
    packages.manifest-multus = fetched;
    checks.manifest-multus-freshness = self.lib.manifestFreshnessCheck pkgs {
      name = "multus";
      committed = self + "/manifests/multus/${versions.version}.yaml";
      rendered = fetched;
    };
  };
}
