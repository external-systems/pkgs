# sealed-secrets component: pinned chart → committed base manifest (SPEC D26).
# packages.manifest-sealed-secrets is the fresh render; the canonical
# consumption path is the committed file manifests/sealed-secrets/<chartVersion>.yaml,
# kept in sync by checks.manifest-sealed-secrets-freshness and regenerated by
# `nix run .#update-manifests`. CRDs ship as a separate atomic artifact
# (CRDs-first ordering is the consumer's contract, SPEC D29).
{self, ...}: {
  # Committed-manifest registry: update-manifests re-renders each entry
  # (package output) into manifests/<path>.
  flake.lib.manifestArtifacts = {
    sealed-secrets = {
      package = "manifest-sealed-secrets";
      path = "sealed-secrets/${(import ../../pkgs/sealed-secrets/versions.nix).chartVersion}.yaml";
    };
    sealed-secrets-crds = {
      package = "crds-sealed-secrets";
      path = "sealed-secrets/${(import ../../pkgs/sealed-secrets/versions.nix).chartVersion}-crds.yaml";
    };
  };

  perSystem = {pkgs, ...}: let
    versions = import ../../pkgs/sealed-secrets/versions.nix;
    chart = pkgs.fetchurl {
      url = versions.chartUrl;
      hash = versions.chartHash;
    };
    # Main render skips CRDs; they are the separate crds-sealed-secrets artifact.
    rendered = self.lib.renderChart pkgs {
      name = "sealed-secrets";
      namespace = "kube-system";
      inherit chart;
      values = import ../../pkgs/sealed-secrets/values.nix;
      kubeVersion = self.lib.versions.kubernetes;
    };
    crds = self.lib.chartCrds pkgs {
      name = "sealed-secrets";
      inherit chart;
    };
  in {
    packages = {
      manifest-sealed-secrets = rendered;
      crds-sealed-secrets = crds;
    };
    checks = {
      manifest-sealed-secrets-freshness = self.lib.manifestFreshnessCheck pkgs {
        name = "sealed-secrets";
        committed = self + "/manifests/sealed-secrets/${versions.chartVersion}.yaml";
        inherit rendered;
      };
      manifest-sealed-secrets-crds-freshness = self.lib.manifestFreshnessCheck pkgs {
        name = "sealed-secrets-crds";
        committed = self + "/manifests/sealed-secrets/${versions.chartVersion}-crds.yaml";
        rendered = crds;
      };
    };
  };
}
