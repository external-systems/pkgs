# external-dns component: pinned chart → committed base manifest (SPEC D26).
# packages.manifest-external-dns is the fresh render; the canonical
# consumption path is the committed file manifests/external-dns/<chartVersion>.yaml,
# kept in sync by checks.manifest-external-dns-freshness and regenerated by
# `nix run .#update-manifests`. CRDs ship as a separate atomic artifact
# (CRDs-first ordering is the consumer's contract, SPEC D29).
{self, ...}: {
  # Committed-manifest registry: update-manifests re-renders each entry
  # (package output) into manifests/<path>.
  flake.lib.manifestArtifacts = {
    external-dns = {
      package = "manifest-external-dns";
      path = "external-dns/${(import ../../pkgs/external-dns/versions.nix).chartVersion}.yaml";
    };
    external-dns-crds = {
      package = "crds-external-dns";
      path = "external-dns/${(import ../../pkgs/external-dns/versions.nix).chartVersion}-crds.yaml";
    };
  };

  perSystem = {pkgs, ...}: let
    versions = import ../../pkgs/external-dns/versions.nix;
    chart = pkgs.fetchurl {
      url = versions.chartUrl;
      hash = versions.chartHash;
    };
    # Main render skips CRDs; they are the separate crds-external-dns artifact.
    rendered = self.lib.renderChart pkgs {
      name = "external-dns";
      namespace = "external-dns";
      inherit chart;
      values = import ../../pkgs/external-dns/values.nix;
      kubeVersion = self.lib.versions.kubernetes;
    };
    crds = self.lib.chartCrds pkgs {
      name = "external-dns";
      inherit chart;
    };
  in {
    packages = {
      manifest-external-dns = rendered;
      crds-external-dns = crds;
    };
    checks = {
      manifest-external-dns-freshness = self.lib.manifestFreshnessCheck pkgs {
        name = "external-dns";
        committed = self + "/manifests/external-dns/${versions.chartVersion}.yaml";
        inherit rendered;
      };
      manifest-external-dns-crds-freshness = self.lib.manifestFreshnessCheck pkgs {
        name = "external-dns-crds";
        committed = self + "/manifests/external-dns/${versions.chartVersion}-crds.yaml";
        rendered = crds;
      };
    };
  };
}
