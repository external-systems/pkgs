# Cilium component: pinned chart → committed base manifest (SPEC D26), plus
# the airgap image set — every container image the committed manifest
# references, as digest-pinned docker-archive tarballs for cluster-side
# loading instead of registry pulls. packages.manifest-cilium is the fresh
# render; the canonical consumption path is the committed file
# manifests/cilium/<chartVersion>.yaml, kept in sync by
# checks.manifest-cilium-freshness and regenerated by
# `nix run .#update-manifests`. packages.image-cilium-* are the tarballs;
# packages.cilium-airgap-images collects them into one directory for VM
# tests to preload.
{self, ...}: let
  versions = import ../../pkgs/cilium/versions.nix;
in {
  # Committed-manifest registry: update-manifests re-renders each entry
  # (package output) into manifests/<path>.
  flake.lib.manifestArtifacts.cilium = {
    package = "manifest-cilium";
    path = "cilium/${versions.chartVersion}.yaml";
  };

  perSystem = {pkgs, ...}: let
    chart = pkgs.fetchurl {
      url = versions.chartUrl;
      hash = versions.chartHash;
    };
    rendered = self.lib.renderChart pkgs {
      name = "cilium";
      namespace = "kube-system";
      inherit chart;
      values = import ../../pkgs/cilium/values.nix;
      kubeVersion = self.lib.versions.kubernetes;
    };
    imageTarballs = builtins.listToAttrs (map (img: {
        name = "image-cilium-${img.name}";
        value = pkgs.dockerTools.pullImage {
          inherit (img) sha256;
          imageName = img.repo;
          imageDigest = img.digest;
          finalImageName = img.repo;
          finalImageTag = img.tag;
          os = "linux";
          arch = "amd64";
        };
      })
      versions.images);
  in {
    packages =
      {
        manifest-cilium = rendered;
        cilium-airgap-images = pkgs.runCommand "cilium-airgap-images" {} ''
          mkdir -p $out
          ${builtins.concatStringsSep "\n" (map (img: "ln -s ${imageTarballs."image-cilium-${img.name}"} $out/cilium-${img.name}-${img.tag}.tar") versions.images)}
        '';
      }
      // imageTarballs;
    checks = {
      manifest-cilium-freshness = self.lib.manifestFreshnessCheck pkgs {
        name = "cilium";
        committed = self + "/manifests/cilium/${versions.chartVersion}.yaml";
        inherit rendered;
      };
      # Every image reference in the committed manifest must be covered by
      # the pinned airgap set (and vice versa) — guards drift between a
      # chart/values bump and versions.images.
      cilium-airgap-completeness = pkgs.runCommand "cilium-airgap-completeness" {} ''
        grep -o 'quay\.io/cilium/[^"]*' ${self + "/manifests/cilium/${versions.chartVersion}.yaml"} | sort -u > manifest-images
        cat > pinned-images <<EOF
        ${builtins.concatStringsSep "\n" (map (img: "${img.repo}:${img.tag}@${img.digest}") versions.images)}
        EOF
        sort -u -o pinned-images pinned-images
        if ! diff -u manifest-images pinned-images; then
          echo "pkgs/cilium/versions.nix images do not match the committed manifest's image references" >&2
          exit 1
        fi
        touch $out
      '';
    };
  };
}
