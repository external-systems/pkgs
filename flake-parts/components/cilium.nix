# Cilium component: pinned chart → committed base manifest (SPEC D26).
# packages.manifest-cilium is the fresh render; the canonical consumption
# path is the committed file manifests/cilium/<chartVersion>.yaml, kept in
# sync by checks.manifest-cilium-freshness and regenerated by
# `nix run .#update-manifests`.
{self, ...}: {
  # Committed-manifest registry: update-manifests re-renders each entry
  # (package output) into manifests/<path>.
  flake.lib.manifestArtifacts.cilium = {
    package = "manifest-cilium";
    path = "cilium/${(import ../../pkgs/cilium/versions.nix).chartVersion}.yaml";
  };

  perSystem = {pkgs, ...}: let
    versions = import ../../pkgs/cilium/versions.nix;
    chart = pkgs.fetchurl {
      url = versions.chartUrl;
      hash = versions.chartHash;
    };
    rendered = self.lib.renderChart pkgs {
      name = "cilium";
      namespace = "kube-system";
      inherit chart;
      values = import ../../pkgs/cilium/values.nix;
      kubeVersion = self.lib.versions.kubernetes;
    };
  in {
    packages.manifest-cilium = rendered;
    checks.manifest-cilium-freshness = self.lib.manifestFreshnessCheck pkgs {
      name = "cilium";
      committed = self + "/manifests/cilium/${versions.chartVersion}.yaml";
      inherit rendered;
    };
  };
}
